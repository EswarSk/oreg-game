{
  "rules": {
    ".read": false,
    ".write": false,

    "invitedNames": {
      ".read": true,
      ".write": false
    },

    "inviteCodes": {
      ".read": false,
      ".write": false
    },

    "clientErrors": {
      ".read": false,
      ".indexOn": ["clientTs"],
      "$id": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['event', 'ts', 'clientTs']) && newData.child('event').isString() && newData.child('event').val().length > 0 && newData.child('event').val().length <= 80 && newData.child('ts').isString() && newData.child('ts').val().length > 0 && newData.child('ts').val().length <= 40 && newData.child('clientTs').isNumber()"
      }
    },

    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'codeHash', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 24 && root.child('invitedNames').child(newData.child('name').val()).val() === true && newData.child('codeHash').isString() && newData.child('codeHash').val() === root.child('inviteCodes').child(newData.child('name').val()).child('hash').val() && newData.child('joinedAt').isNumber()"
      }
    },

    "playerNames": {
      "$name": {
        ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
        ".write": "auth != null && root.child('players').child(auth.uid).child('name').val() === $name && newData.val() === auth.uid",
        ".validate": "newData.isString()"
      }
    },

    "roster": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "$name": {
        ".write": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && root.child('players').child(auth.uid).child('name').val() === $name",
        ".validate": "newData.val() === true"
      }
    },

    "lobbyMessages": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && ((!data.exists() && newData.exists() && newData.child('name').val() === root.child('players').child(auth.uid).child('name').val()) || (data.exists() && !newData.exists() && data.child('name').val() === root.child('players').child(auth.uid).child('name').val()))",
        ".validate": "!newData.exists() || (newData.hasChildren(['name', 'text', 'ts']) && newData.child('name').isString() && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 120 && newData.child('ts').isNumber())"
      }
    },

    "gameStarts": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "$name": {
        ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && root.child('players').child(auth.uid).child('name').val() === $name",
        ".validate": "newData.hasChildren(['ts']) && newData.child('ts').isNumber() && (!newData.child('id').exists() || (newData.child('id').isString() && newData.child('id').val().length > 0 && newData.child('id').val().length <= 80))"
      }
    },

    "cardClaims": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "$cardId": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
      }
    },

    "scores": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "$name": {
        ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
        ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 10000"
      }
    },

    "hands": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "$name": {
        ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && root.child('players').child(auth.uid).child('name').val() === $name"
      }
    },

    "hype": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "count": {
        ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
      },
      "by": {
        "$name": {
          ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && root.child('players').child(auth.uid).child('name').val() === $name",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
        }
      }
    },

    "votes": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "$name": {
        ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && root.child('players').child(auth.uid).child('name').val() === $name",
        ".validate": "newData.isString()"
      }
    },

    "stopVotes": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "$route": {
        "$stop": {
          "$name": {
            ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && root.child('players').child(auth.uid).child('name').val() === $name",
            ".validate": "newData.isString()"
          }
        }
      }
    },

    "routeProgress": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "$route": {
        "players": {
          "$name": {
            ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && root.child('players').child(auth.uid).child('name').val() === $name"
          }
        }
      }
    },

    "feed": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && (!newData.exists() || newData.child('name').val() === root.child('players').child(auth.uid).child('name').val())"
      }
    },

    "missionClaims": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "$mission": {
        "$name": {
          ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && root.child('players').child(auth.uid).child('name').val() === $name"
        }
      }
    },

    "photos": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      ".indexOn": ["ts"],
      "$photoId": {
        ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && ((!data.exists() && newData.exists() && newData.child('name').val() === root.child('players').child(auth.uid).child('name').val()) || (data.exists() && !newData.exists() && data.child('name').val() === root.child('players').child(auth.uid).child('name').val()))",
        ".validate": "!newData.exists() || (newData.hasChildren(['name', 'missionId', 'missionTitle', 'pts', 'dataUrl', 'ts']) && newData.child('name').isString() && newData.child('missionId').isString() && newData.child('missionTitle').isString() && newData.child('pts').isNumber() && newData.child('dataUrl').isString() && newData.child('ts').isNumber() && ((!data.exists() && newData.child('name').val() === root.child('players').child(auth.uid).child('name').val()) || (data.exists() && newData.child('name').val() === data.child('name').val())))",
        "reactions": {
          "$emoji": {
            "$name": {
              ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid && root.child('players').child(auth.uid).child('name').val() === $name && (newData.val() === true || !newData.exists())"
            }
          }
        }
      }
    },

    "hotseat": {
      ".read": "auth != null && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      ".write": "auth != null && now >= 1781938800000 && root.child('playerNames').child(root.child('players').child(auth.uid).child('name').val()).val() === auth.uid",
      "history": {
        ".indexOn": ["ts"]
      }
    }
  }
}
